function og_render_users_page():never{
    $u=og_require_web_user('admin');$msg='';
    if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
        og_require_csrf();$id=(int)($_POST['id']??0);
        if($id===(int)$u['id'])$msg=og_error_card('You cannot disable your active Administrator account.');
        else{og_db()->prepare('UPDATE users SET enabled=CASE enabled WHEN 1 THEN 0 ELSE 1 END WHERE id=?')->execute([$id]);og_db()->prepare('UPDATE api_tokens SET revoked_at=? WHERE user_id=? AND revoked_at IS NULL')->execute([time(),$id]);og_audit((int)$u['id'],'user_status_toggle','user_id='.$id);$msg=og_success_card('User status updated and active API sessions revoked.');}
    }
    $rows=og_db()->query('SELECT id,username,display_name,role,enabled,created_at,last_login_at FROM users ORDER BY created_at DESC')->fetchAll();
    $enabled=0;$admins=0;foreach($rows as$r){if($r['enabled'])$enabled++;if($r['role']==='admin')$admins++;}
    $body='<div class="grid"><div class="card metric"><b>'.count($rows).'</b><div class="muted">Total accounts</div></div><div class="card metric"><b class="ok">'.$enabled.'</b><div class="muted">Enabled accounts</div></div><div class="card metric"><b>'.$admins.'</b><div class="muted">Administrators</div></div></div>'.$msg;
    $body.='<div class="card"><div class="card-head"><div><h2>User access</h2><p class="muted">Enable or disable Cloud accounts. Disabling an account revokes active API sessions.</p></div><span class="pill">Administrator only</span></div><div class="table-shell scroll"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Created</th><th>Last login</th><th>Action</th></tr></thead><tbody>';
    foreach($rows as$r){$body.='<tr><td><b>'.og_h((string)$r['display_name']).'</b><br><span class="muted">@'.og_h((string)$r['username']).'</span></td><td>'.og_h((string)$r['role']).'</td><td><span class="status-badge '.($r['enabled']?'good':'danger').'">'.($r['enabled']?'Enabled':'Disabled').'</span></td><td>'.og_h(og_ui_time((int)$r['created_at'])).'</td><td>'.($r['last_login_at']?og_h(og_ui_time((int)$r['last_login_at'])):'<span class="muted">Never</span>').'</td><td><form class="inline-form" method="post" action="users.php"><input type="hidden" name="csrf" value="'.og_h(og_csrf()).'"><input type="hidden" name="id" value="'.(int)$r['id'].'"><button class="secondary">'.($r['enabled']?'Disable':'Enable').'</button></form></td></tr>';}
    $body.='</tbody></table></div></div>';
    og_layout('Users',$body,$u);
}
function og_render_audit_page():never{
    $u=og_require_web_user('admin');$q=trim((string)($_GET['q']??''));
    $rows=og_db()->query('SELECT a.*,u.username FROM audit_log a LEFT JOIN users u ON u.id=a.user_id ORDER BY a.id DESC LIMIT 1000')->fetchAll();
    if($q!=='')$rows=array_values(array_filter($rows,static fn(array$r):bool=>stripos((string)($r['username']??'system'),$q)!==false||stripos((string)$r['action'],$q)!==false||stripos((string)$r['detail'],$q)!==false));
    $body='<div class="card compact"><form class="toolbar" method="get" action="audit.php"><label>Search audit log<input name="q" value="'.og_h($q).'" placeholder="User, action, or detail"></label><div class="toolbar-action"><button>Search</button></div></form><div class="filter-summary"><span>Showing <b>'.count($rows).'</b> events</span>'.($q!==''?'<a href="audit.php">Clear search</a>':'').'</div></div>';
    $body.='<div class="card"><div class="card-head"><div><h2>Security audit</h2><p class="muted">Authentication, upload, metadata access, recovery, update, and administration events.</p></div><span class="pill">Latest 1,000</span></div><div class="table-shell scroll"><table><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Detail</th></tr></thead><tbody>';
    foreach($rows as$r)$body.='<tr><td>'.og_h(og_ui_time((int)$r['created_at'])).'</td><td>'.og_h((string)($r['username']??'system')).'</td><td><span class="pill">'.og_h((string)$r['action']).'</span></td><td>'.og_h((string)$r['detail']).'</td></tr>';
    if(!$rows)$body.='<tr><td colspan="4"><div class="empty"><b>No matching audit events</b></div></td></tr>';
    $body.='</tbody></table></div></div>';
    og_layout('Audit log',$body,$u);
}
function og_render_system_page():never{
    $u=og_require_web_user('admin');$crypto=og_crypto_capabilities();$db=og_db();
    $objects=(int)$db->query('SELECT COUNT(*) FROM objects')->fetchColumn();$users=(int)$db->query('SELECT COUNT(*) FROM users')->fetchColumn();$audits=(int)$db->query('SELECT COUNT(*) FROM audit_log')->fetchColumn();
    $backend=$crypto['php_openssl']?'PHP OpenSSL':($crypto['openssl_cli']?'OpenSSL CLI':'Unavailable');
    $body='<div class="grid"><div class="card metric"><b>'.og_h(OG_VERSION).'</b><div class="muted">Cloud version</div></div><div class="card metric"><b class="'.($crypto['ready']?'ok':'bad').'">'.og_h($backend).'</b><div class="muted">Cryptographic backend</div></div><div class="card metric"><b class="'.($crypto['data_writable']?'ok':'bad').'">'.($crypto['data_writable']?'Writable':'Blocked').'</b><div class="muted">Secure data directory</div></div><div class="card metric"><b>'.og_h((string)$crypto['php_version']).'</b><div class="muted">PHP runtime</div></div></div>';
    $body.='<div class="split"><div class="card"><div class="card-head"><div><h2>Server readiness</h2><p class="muted">Live cryptographic and storage capabilities.</p></div><span class="status-badge '.($crypto['ready']?'good':'danger').'">'.($crypto['ready']?'Operational':'Action required').'</span></div><div class="status-list"><div><span>PHP OpenSSL</span><b>'.($crypto['php_openssl']?'Ready':'Unavailable').'</b></div><div><span>OpenSSL CLI fallback</span><b>'.($crypto['openssl_cli']?'Ready':'Unavailable').'</b></div><div><span>Data directory</span><b>'.($crypto['data_writable']?'Writable':'Not writable').'</b></div><div><span>Escrow architecture</span><b>Dual-envelope OGC2</b></div></div><div class="note">Administrator escrow material remains in the protected runtime data directory and is never included in deployment packages.</div></div><div class="card"><h2>Database inventory</h2><div class="status-list"><div><span>Users</span><b>'.$users.'</b></div><div><span>Encrypted objects</span><b>'.$objects.'</b></div><div><span>Audit events</span><b>'.$audits.'</b></div></div><a class="action-link full" href="healthcheck.php">Open healthcheck</a></div></div>';
    og_layout('System status',$body,$u);
}
function og_render_updates_page():never{
    $u=og_require_web_user('admin');$manifest=is_file(OG_RELEASE)?json_decode((string)file_get_contents(OG_RELEASE),true):[];
    $available=($manifest['available']??false)===true;$mandatory=($manifest['forceUpdate']??false)===true||($manifest['updatePolicy']??'')==='mandatory';$apk=(string)($manifest['apkUrl']??'');
    $body='<div class="grid"><div class="card metric"><b>'.og_h((string)($manifest['versionName']??'Unavailable')).'</b><div class="muted">Published Android version</div></div><div class="card metric"><b>'.og_h((string)($manifest['versionCode']??'—')).'</b><div class="muted">Version code</div></div><div class="card metric"><b class="'.($mandatory?'ok':'bad').'">'.($mandatory?'Mandatory':'Optional').'</b><div class="muted">Update policy</div></div><div class="card metric"><b class="'.($available?'ok':'bad').'">'.($available?'Available':'Disabled').'</b><div class="muted">Release channel</div></div></div>';
    $body.='<div class="split"><div class="card"><div class="card-head"><div><h2>Updater manifest</h2><p class="muted">The Android app validates this manifest before downloading a signed release.</p></div><span class="status-badge '.($mandatory?'good':'danger').'">'.($mandatory?'Forced update':'Not forced').'</span></div><div class="status-list"><div><span>Package</span><b>'.og_h((string)($manifest['packageName']??'com.fantest.ownerguard')).'</b></div><div><span>Minimum version code</span><b>'.og_h((string)($manifest['minimumVersionCode']??'—')).'</b></div><div><span>Minimum Android SDK</span><b>'.og_h((string)($manifest['minSdk']??'—')).'</b></div><div><span>APK size</span><b>'.number_format((int)($manifest['size']??0)).' B</b></div></div>'.($apk!==''?'<a class="action-link full" href="'.og_h($apk).'">Download published APK</a>':'').'</div><div class="card"><h2>Integrity</h2><div class="muted">SHA-256</div><div class="mono hash-block">'.og_h((string)($manifest['sha256']??'Unavailable')).'</div><div class="muted">Release notes</div><p>'.og_h((string)($manifest['releaseNotes']??'No release notes published.')).'</p></div></div><div class="note">The app verifies package name, version code, exact byte size, SHA-256, and the installed OwnerGuard signing certificate before opening Android’s installer.</div>';
    og_layout('Update management',$body,$u);
}
function og_render_settings_page():never{og_render_users_page();}
